{%- if no_data -%}
<div class="layout layout--col layout--center">
  <span class="title">{{ s_nodata }}</span>
  <span class="description">meteo.dob-world.com {{ s_nodata_desc }}</span>
</div>
{%- else -%}
{%- assign chart_id = "chart-" | append_random -%}
{%- capture rain_line -%}{%- if rain.size == 0 -%}{{ s_norain }}{%- else -%}{%- for w in rain -%}{%- assign mm = w.mm | replace: ".", dec -%}{{ s_rain }} {{ w.from }}–{{ w.to }}h{% if w.tomorrow %} ({{ s_tomorrow }}){% endif %} · {{ mm }} mm{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
<div class="layout layout--col gap--space-between">

  <div class="grid">
    <div class="col gap--small col--span-4">
      <div class="flex flex--row flex--left flex--center-y gap--small"><span class="lg:hidden">{{ icons[now.sky.icon] | replace: "__S__", "56" }}</span><span class="hidden lg:visible">{{ icons[now.sky.icon] | replace: "__S__", "88" }}</span><span class="label label--underline lg:label--large">{{ s_now }} · {{ now.time }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--tnums value--xxxlarge" data-value-fit="true">{{ n_temp }}°</span>
          <span class="label lg:label--large">{{ cur_sky }} · {{ s_feels }} {{ n_feels }}°</span>
          <span class="label label--small lg:label--base">{{ s_wind }} {{ now.wind }} km/h {{ w_dir }} · {{ s_hum }} {{ now.hum }}%</span>
        </div>
      </div>
    </div>

    <div class="col col--span-8 gap--small">
      <span class="label label--small">{{ s_next24 }} · {{ s_bars }}</span>
      <div id="{{ chart_id }}" class="w--full"></div>
    </div>
  </div>

  <span class="label label--small lg:label--base">{{ rain_line }}</span>

  <div class="hidden lg:grid grid--cols-4 gap--small">
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--tnums value--small">{{ sunrise }}–{{ sunset }}</span><span class="label label--small">{{ s_sun }}</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--tnums value--small">{{ now.uv | default: "—" | replace: ".", dec }}</span><span class="label label--small">{{ s_uv }}</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--tnums value--small">{{ now.gust | default: "—" }} km/h</span><span class="label label--small">{{ s_gust }}</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--tnums value--small">{{ n_rain24 | default: "0" }} mm</span><span class="label label--small">{{ s_rain }} 24 h</span></div></div>
  </div>

  <div class="divider"></div>

  <div class="grid grid--cols-5">
    {%- for d in days limit: 5 -%}
    <div class="col col--center gap--small">
      <span class="label label--underline lg:label--large">{% if d.today %}{{ s_today }}{% else %}{{ day_names[d.dow] }}{% endif %}</span>
      <span class="lg:hidden">{{ icons[d.sky.icon] | replace: "__S__", "40" }}</span><span class="hidden lg:visible">{{ icons[d.sky.icon] | replace: "__S__", "64" }}</span>
      <div class="flex flex--row flex--center-y gap--small"><span class="value value--tnums value--small lg:value--xlarge">{{ d.tmax | default: "—" }}°</span><span class="label lg:label--large">/ {{ d.tmin | default: "—" }}°</span></div>
      <span class="label label--small lg:label--base">{{ d.pop | default: "—" }}% · {{ d.mm | replace: ".", dec }} mm</span>
      <span class="hidden lg:visible label label--small">{{ d.wind | default: "—" }} km/h {{ d.wind_dir }}</span>
    </div>
    {%- endfor -%}
  </div>

</div>
<script>fcChart('{{ chart_id }}', {{ series.temp_hourly | json }}, { fill: true, suffix: '°', tick: 3, size: 13, labelEvery: 6, rain: {{ series.rain_hourly | json }} });</script>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ icon_b64 }}">
  <span class="title">{{ location }} · {{ s_next24 }}</span>
  <span class="instance">{{ updated }}{% if stale %} ({{ s_delayed }}){% endif %}</span>
</div>
