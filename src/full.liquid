{%- if no_data -%}
<div class="layout layout--col layout--center">
  <span class="title">{{ s_nodata }}</span>
  <span class="description">meteo.dob-world.com {{ s_nodata_desc }}</span>
</div>
{%- else -%}
{%- capture rain_line -%}{%- if rain.size == 0 -%}{{ s_norain }}{%- else -%}{%- for w in rain -%}{%- assign mm = w.mm | replace: ".", dec -%}{{ s_rain }} {{ w.from }}–{{ w.to }}h{% if w.tomorrow %} ({{ s_tomorrow }}){% endif %} · {{ mm }} mm{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
<div class="layout layout--col gap--space-between">

  <div class="grid">
    <div class="col gap--small col--span-4">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ icons[now.sky.icon] | replace: "__S__", "56" }}<span class="label label--underline">{{ s_now }} · {{ now.time }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--tnums value--xxxlarge" data-value-fit="true">{{ n_temp }}°</span>
          <span class="label">{{ cur_sky }} · {{ s_feels }} {{ n_feels }}°</span>
          <span class="label label--small">{{ s_wind }} {{ now.wind }} km/h {{ w_dir }} · {{ s_hum }} {{ now.hum }}%</span>
        </div>
      </div>
    </div>

    <div class="col col--span-8 gap--small">
      <span class="label label--small">{{ s_next24 }} · {{ s_bars }}</span>
      <div id="chart-fc" class="w--full"></div>
    </div>
  </div>

  <span class="label label--small">{{ rain_line }}</span>

  <div class="w--full b-h-gray-5"></div>

  <div class="grid grid--cols-5">
    {%- for d in days limit: 5 -%}
    <div class="col col--center gap--small">
      <span class="label label--underline">{% if d.today %}{{ s_today }}{% else %}{{ day_names[d.dow] }}{% endif %}</span>
      {{ icons[d.sky.icon] | replace: "__S__", "40" }}
      <span class="value value--tnums value--small">{{ d.tmax }}° <span class="label">/ {{ d.tmin }}°</span></span>
      <span class="label label--small">{{ d.pop }}% · {{ d.mm | replace: ".", dec }} mm</span>
    </div>
    {%- endfor -%}
  </div>

</div>
<script>fcChart('chart-fc', {{ series.temp_hourly | json }}, { height: 170, fill: true, suffix: '°', tick: 3, size: 13, labelEvery: 6, rain: {{ series.rain_hourly | json }} });</script>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ icon_b64 }}">
  <span class="title">{{ location }} · {{ s_next24 }}</span>
  <span class="instance">{{ updated }}{% if stale %} ({{ s_delayed }}){% endif %}</span>
</div>
