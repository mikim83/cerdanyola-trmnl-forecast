{%- if no_data -%}
<div class="layout layout--col layout--center">
  <span class="title">{{ s_nodata }}</span>
  <span class="description">meteo.dob-world.com {{ s_nodata_desc }}</span>
</div>
{%- else -%}
{%- capture rain_line -%}{%- if rain.size == 0 -%}{{ s_norain }}{%- else -%}{%- for w in rain -%}{%- assign mm = w.mm | replace: ".", dec -%}{{ s_rain }} {{ w.from }}–{{ w.to }}h{% if w.tomorrow %} ({{ s_tomorrow }}){% endif %} · {{ mm }} mm{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
<div class="layout layout--col layout--center">
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <div class="flex flex--row flex--center-y gap--small"><span class="lg:hidden">{{ icons[now.sky.icon] | replace: "__S__", "40" }}</span><span class="hidden lg:visible">{{ icons[now.sky.icon] | replace: "__S__", "72" }}</span><span class="value value--tnums value--xlarge lg:value--xxlarge" data-value-fit="true">{{ n_temp }}°</span></div>
      <span class="label lg:label--large">{% if today %}{{ today.tmax | default: "—" }}° / {{ today.tmin | default: "—" }}° · {% endif %}{{ cur_sky }}</span>
      <span class="hidden lg:visible label label--small">{{ s_feels }} {{ n_feels }}° · {{ s_wind }} {{ now.wind }} km/h {{ w_dir }} · {{ s_hum }} {{ now.hum }}%</span>
      <span class="label label--small lg:label--base">{{ rain_line }}</span>
    </div>
  </div>
  {%- comment -%} Solo en TRMNX: los 3 días siguientes (hay sitio de sobra en el cuarto de pantalla) {%- endcomment -%}
  <div class="hidden lg:visible w--full">
    <div class="divider"></div>
    <div class="grid grid--cols-3">
      {%- for d in days offset: 1 limit: 3 -%}
      <div class="col col--center gap--small">
        <span class="label label--underline">{{ day_names[d.dow] }}</span>
        {{ icons[d.sky.icon] | replace: "__S__", "40" }}
        <div class="flex flex--row flex--center-y gap--small"><span class="value value--tnums value--small">{{ d.tmax | default: "—" }}°</span><span class="label">/ {{ d.tmin | default: "—" }}°</span></div>
        <span class="label label--small">{{ d.pop | default: "—" }}%</span>
      </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ icon_b64 }}">
  <span class="title">{{ location }}</span>
  <span class="instance">{{ updated }}</span>
</div>
