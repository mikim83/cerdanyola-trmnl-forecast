{%- if no_data -%}
<div class="layout layout--col layout--center">
  <span class="title">{{ s_nodata }}</span>
  <span class="description">meteo.dob-world.com {{ s_nodata_desc }}</span>
</div>
{%- else -%}
{%- capture rain_line -%}{%- if rain.size == 0 -%}{{ s_norain }}{%- else -%}{%- for w in rain -%}{%- assign mm = w.mm | replace: ".", dec -%}{{ s_rain }} {{ w.from }}–{{ w.to }}h{% if w.tomorrow %} ({{ s_tomorrow }}){% endif %} · {{ mm }} mm{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
<div class="layout layout--col gap--space-between">
  <div class="flex flex--row flex--left flex--center-y gap--medium">
    {{ icons[now.sky.icon] | replace: "__S__", "56" }}
    <div class="col gap--small">
      <span class="value value--tnums value--xlarge">{{ n_temp }}°</span>
      <span class="label">{{ cur_sky }} · {{ s_feels }} {{ n_feels }}°</span>
    </div>
  </div>
  <span class="label label--small">{{ rain_line }}</span>
  <div class="w--full b-h-gray-5"></div>
  <div class="grid grid--cols-4 gap--small">
    {%- for d in days limit: 5 -%}
    <span class="label">{% if d.today %}{{ s_today }}{% else %}{{ day_names[d.dow] }}{% endif %}</span>
    <span>{{ icons[d.sky.icon] | replace: "__S__", "26" }}</span>
    <span class="label">{{ d.tmax }}° / {{ d.tmin }}°</span>
    <span class="label label--small">{{ d.pop }}%</span>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ icon_b64 }}">
  <span class="title">{{ location }}</span>
  <span class="instance">{{ updated }}</span>
</div>
